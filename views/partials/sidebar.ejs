<script>
(() => {
    const toggleButton = document.getElementById('toggle-all-sidebar');
    const panels = Array.from(document.querySelectorAll('.sidebar-nav'));

    if (!toggleButton || !panels.length) return;

    let expanded = true;

    const setAll = (open) => {
        panels.forEach((panel) => {
            panel.open = open;
        });
        expanded = open;
        toggleButton.textContent = open ? 'Collapse all' : 'Expand all';
    };

    toggleButton.addEventListener('click', () => {
        setAll(!expanded);
    });

    window.addEventListener('resize', () => {
        if (window.innerWidth < 960) {
            setAll(false);
        } else if (expanded === false) {
            setAll(true);
        }
    });

    if (window.innerWidth < 960) {
        setAll(false);
    }
})();
