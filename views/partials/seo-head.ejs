<title><%= seo.title %></title>
<meta name='theme-color' content='#09090b'>
<link rel='preconnect' href='https://<%= site.url.replace(/\/$/, '') %>' crossorigin>
<link rel='dns-prefetch' href='//<%= site.url.replace(/^https?:\/\//, '').replace(/\/$/, '') %>'>
<link rel='preconnect' href='https://www.googletagmanager.com' crossorigin>
<!-- Keep preconnect limited to origins needed during the initial render. -->
<link rel='preconnect' href='https://<%= adScriptHost %>' crossorigin>
<link rel='dns-prefetch' href='//www.eporner.com'>
<link rel='dns-prefetch' href='//www.pornhub.com'>
<script>
(() => {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    let preference = 'dark';
    try { preference = localStorage.getItem('theme') || 'dark'; } catch {}
    const resolved = preference === 'auto'
        ? (media.matches ? 'dark' : 'light')
        : preference;
    root.dataset.theme = resolved;
    root.dataset.themePreference = preference;
    document.querySelector('meta[name=theme-color]')?.setAttribute('content', resolved === 'dark' ? '#09090b' : '#f4f5f8');
})();
</script>
<link rel='icon' href='/favicon.png' type='image/png' sizes='2000x2000'>
<link rel='apple-touch-icon' href='/favicon.png' sizes='2000x2000'>
<meta name='description' content='<%= seo.description %>'>
<meta name='robots' content='<%= seo.robots %>'>
<meta name='googlebot' content='<%= seo.robots %>'>
<link rel='canonical' href='<%= seo.canonical %>'>
<% if (seo.prev) { %><link rel='prev' href='<%= seo.prev %>'><% } %>
<% if (seo.next) { %><link rel='next' href='<%= seo.next %>'><% } %>
<% if (seo.explicit) { %><meta name='rating' content='adult'><% } %>
<% if (site.googleSiteVerification) { %>
<meta name='google-site-verification' content='<%= site.googleSiteVerification %>'>
<% } %>
<meta property='og:type' content='<%= seo.type %>'>
<meta property='og:site_name' content='<%= site.name %>'>
<meta property='og:locale' content='<%= ({ id: 'id_ID', en: 'en_US', ms: 'ms_MY', es: 'es_ES', ja: 'ja_JP' }[lang] || 'en_US') %>'>
<meta property='og:title' content='<%= seo.title %>'>
<meta property='og:description' content='<%= seo.description %>'>
<meta property='og:url' content='<%= seo.canonical %>'>
<% if (seo.image) { %><meta property='og:image' content='<%= seo.image %>'><% } %>
<% if (seo.video) { %><meta property='og:video' content='<%= seo.video %>'><% } %>
<meta name='twitter:card' content='<%= seo.image ? 'summary_large_image' : 'summary' %>'>
<meta name='twitter:title' content='<%= seo.title %>'>
<meta name='twitter:description' content='<%= seo.description %>'>
<% if (seo.image) { %><meta name='twitter:image' content='<%= seo.image %>'><% } %>
<% if (seo.jsonLd) { %>
<script type='application/ld+json'><%- safeJson(seo.jsonLd) %></script>
<% } %>
