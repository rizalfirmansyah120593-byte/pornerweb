<header class="main-header">
    <a href="/" class="brand-pill" aria-label="Kembali ke beranda">
        <span class="brand-mark">▶</span>
        <span class="brand-text">PORNERWEB</span>
    </a>

    <form action="/" method="GET" class="search-box">
        <input type="text" name="q" placeholder="<%= t.placeholder %>" required>
        <button type="submit" aria-label="Cari">🔍</button>
    </form>

    <div class="header-controls">
        <button type="button" class="mobile-sidebar-toggle" id="mobile-sidebar-toggle" aria-controls="site-sidebar" aria-expanded="false">
            <span aria-hidden="true">☰</span>
            <span class="mobile-sidebar-toggle__label">Menu</span>
        </button>
        <div class="theme-switcher" aria-label="Pilihan tema">
            <button data-theme-choice="light" aria-label="Light Mode">☀️</button>
            <button data-theme-choice="dark" aria-label="Dark Mode">🌙</button>
        </div>

        <select id="language-selector" aria-label="Pilih bahasa">
            <option value="id" <%= (typeof lang !== 'undefined' && lang === 'id') ? 'selected' : '' %>>ID</option>
            <option value="en" <%= (typeof lang !== 'undefined' && lang === 'en') ? 'selected' : '' %>>EN</option>
        </select>

    </div>
</header>

<script>
(() => {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const themeButtons = document.querySelectorAll('[data-theme-choice]');
    const themeMeta = document.querySelector('meta[name="theme-color"]');

    const getStoredTheme = () => {
        try { return localStorage.getItem('theme') || 'auto'; } catch { return 'auto'; }
    };

    function applyTheme(preference, persist = true) {
        const safePreference = ['light', 'dark', 'auto'].includes(preference) ? preference : 'auto';
        const resolvedTheme = safePreference === 'auto' ? (media.matches ? 'dark' : 'light') : safePreference;
        root.dataset.theme = resolvedTheme;
        root.dataset.themePreference = safePreference;

        if (persist) {
            try { localStorage.setItem('theme', safePreference); } catch {}
        }

        themeButtons.forEach((button) => {
            const isActive = button.dataset.themeChoice === resolvedTheme;
            button.setAttribute('aria-pressed', String(isActive));
            button.classList.toggle('is-active', isActive);
        });

        if (themeMeta) {
            themeMeta.setAttribute('content', resolvedTheme === 'dark' ? '#09090b' : '#f4f5f8');
        }
    }

    themeButtons.forEach((button) => {
        button.addEventListener('click', () => applyTheme(button.dataset.themeChoice));
    });

    media.addEventListener('change', () => {
        if (getStoredTheme() === 'auto') applyTheme('auto', false);
    });

    applyTheme(getStoredTheme(), false);

    document.getElementById('language-selector')?.addEventListener('change', (event) => {
        window.location.href = `/set-lang?lang=${encodeURIComponent(event.target.value)}`;
    });

    const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
    const sidebar = document.getElementById('site-sidebar');
    if (sidebarToggle && sidebar) {
        sidebarToggle.addEventListener('click', () => {
            const isOpen = document.body.classList.toggle('mobile-sidebar-open');
            sidebarToggle.setAttribute('aria-expanded', String(isOpen));
            sidebarToggle.querySelector('.mobile-sidebar-toggle__label').textContent = isOpen ? 'Tutup' : 'Menu';
        });

        sidebar.addEventListener('click', (event) => {
            if (event.target.closest('a')) {
                document.body.classList.remove('mobile-sidebar-open');
                sidebarToggle.setAttribute('aria-expanded', 'false');
                sidebarToggle.querySelector('.mobile-sidebar-toggle__label').textContent = 'Menu';
            }
        });
    }
})();
</script>
