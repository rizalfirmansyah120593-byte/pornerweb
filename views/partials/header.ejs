<header class="main-header">
    <a href="/" class="brand-pill" aria-label="Kembali ke beranda">
        <span class="brand-text">PORNER<span>WEB</span></span>
    </a>

    <form action="/" method="GET" class="search-box">
        <input type="text" name="q" placeholder="<%= t.placeholder %>" required>
        <button type="submit" aria-label="Cari">🔍</button>
    </form>

    <a class="donation-button" href="https://saweria.co/RizalFirmansyah" target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">❤</span> Donasi
    </a>

    <div class="header-controls">
        <button type="button" class="mobile-sidebar-toggle" id="mobile-sidebar-toggle" aria-controls="site-sidebar" aria-expanded="false">
            <span aria-hidden="true">☰</span>
            <span class="mobile-sidebar-toggle__label">Menu</span>
        </button>
        <div class="theme-switcher" aria-label="Pilihan tema">
            <button data-theme-choice="light" aria-label="Light Mode">☀️</button>
            <button data-theme-choice="dark" aria-label="Dark Mode">🌙</button>
        </div>

        <select id="language-selector" aria-label="Pilih bahasa">
            <option value="id" <%= (typeof lang !== 'undefined' && lang === 'id') ? 'selected' : '' %>>ID</option>
            <option value="en" <%= (typeof lang !== 'undefined' && lang === 'en') ? 'selected' : '' %>>EN</option>
            <option value="ms" <%= (typeof lang !== 'undefined' && lang === 'ms') ? 'selected' : '' %>>MS</option>
            <option value="es" <%= (typeof lang !== 'undefined' && lang === 'es') ? 'selected' : '' %>>ES</option>
            <option value="ja" <%= (typeof lang !== 'undefined' && lang === 'ja') ? 'selected' : '' %>>JA</option>
        </select>

    </div>
</header>

<% const ageGateText = {
    id: { language: 'Bahasa', title: 'Ini adalah website dewasa', notice: 'Pemberitahuan untuk Pengguna', body: 'Website ini berisi materi yang dibatasi usia termasuk ketelanjangan dan penggambaran aktivitas seksual eksplisit. Dengan masuk, Anda menyatakan telah berusia minimal 18 tahun atau telah mencapai usia dewasa di wilayah hukum Anda dan menyetujui untuk melihat konten eksplisit.', law: 'Pemberitahuan untuk Penegak Hukum', enter: 'Saya berusia 18 tahun atau lebih - Masuk', exit: 'Saya berusia di bawah 18 tahun - Keluar', controls: 'Halaman kontrol orang tua kami menjelaskan cara memblokir akses ke situs ini.', terms: 'Ketentuan Layanan' },
    en: { language: 'English', title: 'This is an adult website', notice: 'Notice to Users', body: 'This website contains age-restricted materials including nudity and explicit depictions of sexual activity. By entering, you affirm that you are at least 18 years of age or the age of majority in your jurisdiction and consent to viewing sexually explicit content.', law: 'Notice to Law Enforcement', enter: 'I am 18 or older - Enter', exit: 'I am under 18 - Exit', controls: 'Our parental controls page explains how you can easily block access to this site.', terms: 'Terms of Service' },
    ms: { language: 'Bahasa Melayu', title: 'Ini ialah laman web dewasa', notice: 'Notis kepada Pengguna', body: 'Laman web ini mengandungi bahan terhad umur termasuk kebogelan dan gambaran aktiviti seksual eksplisit. Dengan masuk, anda mengesahkan bahawa anda berumur sekurang-kurangnya 18 tahun atau telah mencapai umur dewasa di bidang kuasa anda.', law: 'Notis kepada Penguat Kuasa', enter: 'Saya berumur 18 tahun atau lebih - Masuk', exit: 'Saya di bawah 18 tahun - Keluar', controls: 'Halaman kawalan ibu bapa kami menerangkan cara menyekat akses ke laman ini.', terms: 'Syarat Perkhidmatan' },
    es: { language: 'Español', title: 'Este es un sitio web para adultos', notice: 'Aviso para los usuarios', body: 'Este sitio contiene material restringido por edad, incluida desnudez y representaciones explícitas de actividad sexual. Al entrar, confirma que tiene al menos 18 años o la mayoría de edad en su jurisdicción y acepta ver contenido sexual explícito.', law: 'Aviso a las autoridades', enter: 'Tengo 18 años o más - Entrar', exit: 'Tengo menos de 18 años - Salir', controls: 'Nuestra página de control parental explica cómo bloquear fácilmente el acceso a este sitio.', terms: 'Términos del servicio' },
    ja: { language: '日本語', title: 'これはアダルトウェブサイトです', notice: 'ユーザーへのお知らせ', body: 'このウェブサイトには、ヌードや性的行為の露骨な描写など、年齢制限のあるコンテンツが含まれています。入場することで、18歳以上またはお住まいの地域の成人年齢に達していることを確認するものとします。', law: '法執行機関へのお知らせ', enter: '18歳以上です - 入場', exit: '18歳未満です - 退出', controls: 'ペアレンタルコントロールのページで、このサイトへのアクセスを簡単にブロックできます。', terms: '利用規約' }
}; const ageCopy = ageGateText[lang] || ageGateText.en; %>
<section class="age-gate" id="age-gate" role="dialog" aria-modal="true" aria-labelledby="age-gate-title">
    <select class="age-gate__language" id="age-gate-language" aria-label="Pilih bahasa">
        <% Object.entries(ageGateText).forEach(([code, copy]) => { %><option value="<%= code %>" <%= lang === code ? 'selected' : '' %>><%= copy.language %></option><% }) %>
    </select>
    <div class="age-gate__content">
        <div class="age-gate__logo">PORNER<span>WEB</span></div>
        <h1 id="age-gate-title"><%= ageCopy.title %></h1>
        <div class="age-gate__notice"><%= ageCopy.notice %></div>
        <p><%= ageCopy.body %></p>
        <a href="/terms"><%= ageCopy.law %></a>
        <div class="age-gate__actions">
            <button type="button" id="age-enter"><%= ageCopy.enter %></button>
            <button type="button" id="age-exit"><%= ageCopy.exit %></button>
        </div>
        <p class="age-gate__controls"><%= ageCopy.controls %><br><a href="/terms"><%= ageCopy.terms %></a></p>
        <small>© 2026 PORNERWEB <b>RTA</b></small>
    </div>
</section>

<style>
    #age-gate { position: fixed !important; inset: 0 !important; z-index: 2147483647 !important; display: grid !important; place-items: center !important; padding: 24px 16px !important; overflow-y: auto !important; background: rgba(2, 5, 13, .78) !important; backdrop-filter: blur(10px) !important; -webkit-backdrop-filter: blur(10px) !important; color: #f5f5f5 !important; }
    #age-gate.is-hidden { display: none !important; }
    #age-gate .age-gate__language { position: absolute !important; top: 10px !important; left: 12px !important; z-index: 2 !important; }
    #age-gate .age-gate__content { width: min(100%, 640px) !important; margin: auto !important; padding: 42px 30px 30px !important; text-align: center !important; background: #0e1524 !important; border: 1px solid rgba(255,255,255,.15) !important; border-top: 3px solid #ffa31a !important; border-radius: 18px !important; box-shadow: 0 25px 80px rgba(0,0,0,.65) !important; }
    #age-gate h1 { margin: 0 0 13px !important; color: #f8f8fb !important; font-size: 28px !important; }
    #age-gate p { color: #c9c9c9 !important; font-size: 13px !important; line-height: 1.45 !important; }
    #age-gate a { color: #ffc04d !important; }
    #age-gate .age-gate__actions { display: flex !important; justify-content: center !important; gap: 8px !important; margin: 31px 0 !important; }
    #age-gate button { min-height: 42px !important; padding: 0 14px !important; border: 1px solid #ffa31a !important; border-radius: 9px !important; background: #111827 !important; color: #eee !important; cursor: pointer !important; }
    #age-gate button:first-child { background: #ffa31a !important; color: #111827 !important; }
    @media (max-width: 600px) { #age-gate .age-gate__content { padding: 34px 18px 24px !important; } #age-gate h1 { font-size: 24px !important; } #age-gate .age-gate__actions { flex-direction: column !important; } }
</style>

<script>
(() => {
    const ageGate = document.getElementById('age-gate');
    const ageEnter = document.getElementById('age-enter');
    const ageExit = document.getElementById('age-exit');
    document.getElementById('age-gate-language')?.addEventListener('change', (event) => {
        window.location.href = `/set-lang?lang=${encodeURIComponent(event.target.value)}`;
    });
    document.body.classList.add('age-gate-active');
    ageEnter?.addEventListener('click', () => {
        ageGate?.classList.add('is-hidden');
        document.body.classList.remove('age-gate-active');
    });
    ageExit?.addEventListener('click', () => { window.location.replace('about:blank'); });

    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const themeButtons = document.querySelectorAll('[data-theme-choice]');
    const themeMeta = document.querySelector('meta[name="theme-color"]');

    const getStoredTheme = () => {
        try { return localStorage.getItem('theme') || 'auto'; } catch { return 'auto'; }
    };

    function applyTheme(preference, persist = true) {
        const safePreference = ['light', 'dark', 'auto'].includes(preference) ? preference : 'auto';
        const resolvedTheme = safePreference === 'auto' ? (media.matches ? 'dark' : 'light') : safePreference;
        root.dataset.theme = resolvedTheme;
        root.dataset.themePreference = safePreference;

        if (persist) {
            try { localStorage.setItem('theme', safePreference); } catch {}
        }

        themeButtons.forEach((button) => {
            const isActive = button.dataset.themeChoice === resolvedTheme;
            button.setAttribute('aria-pressed', String(isActive));
            button.classList.toggle('is-active', isActive);
        });

        if (themeMeta) {
            themeMeta.setAttribute('content', resolvedTheme === 'dark' ? '#09090b' : '#f4f5f8');
        }
    }

    themeButtons.forEach((button) => {
        button.addEventListener('click', () => applyTheme(button.dataset.themeChoice));
    });

    media.addEventListener('change', () => {
        if (getStoredTheme() === 'auto') applyTheme('auto', false);
    });

    applyTheme(getStoredTheme(), false);

    document.getElementById('language-selector')?.addEventListener('change', (event) => {
        window.location.href = `/set-lang?lang=${encodeURIComponent(event.target.value)}`;
    });

    const initMobileSidebar = () => {
        const sidebarToggle = document.getElementById('mobile-sidebar-toggle');
        const sidebar = document.getElementById('site-sidebar');
        if (!sidebarToggle || !sidebar || sidebarToggle.dataset.initialized === 'true') return;

        sidebarToggle.dataset.initialized = 'true';
        sidebarToggle.addEventListener('click', () => {
            const isOpen = document.body.classList.toggle('mobile-sidebar-open');
            sidebarToggle.setAttribute('aria-expanded', String(isOpen));
            sidebarToggle.querySelector('.mobile-sidebar-toggle__label').textContent = isOpen ? 'Tutup' : 'Menu';
        });

        sidebar.addEventListener('click', (event) => {
            if (event.target.closest('a')) {
                document.body.classList.remove('mobile-sidebar-open');
                sidebarToggle.setAttribute('aria-expanded', 'false');
                sidebarToggle.querySelector('.mobile-sidebar-toggle__label').textContent = 'Menu';
            }
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMobileSidebar);
    } else {
        initMobileSidebar();
    }
})();
</script>
