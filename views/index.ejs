                <div class="duration-meta">
                <span class="duration-label">Durasi:</span>
                <span class="duration-value"><%= item.duration %></span>
                <span class="views"> | Views: 
                    <strong style="color: #FFFFFF;"><%= item.views %></strong>
                </span>
            </div>
            <!-- Judul video di dalam loop (menggunakan item, bukan video) -->
            <a href="/watch?url=<%= encodeURIComponent(item.url) %>" style="text-decoration: none; color: inherit;"></a>
            <h4 class="video-title"><%= item.title %></h4>
        </div>
    <% }) %>
</div>

<div class="search-results">
    <h2>Search Results: <%= query %></h2>
</div>
        <!-- Pagination -->
<div class="pagination">
    <% 
        // Logika untuk menentukan range angka yang tampil
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(10, currentPage + 2); // 10 adalah batas maksimal halaman
    %>
    <!-- Tombol Previous -->
    <% if (currentPage > 1) { %>
        <a href="/?q=<%= query %>&page=<%= currentPage - 1 %>">«</a>
    <% } %>

    <!-- Loop Angka Halaman -->
    <% for(let i = 1; i <= 10; i++) { %>
        <a href="/?q=<%= query %>&page=<%= i %>" 
           class="<%= currentPage == i ? 'active' : '' %>">
           <%= i %>
        </a>
    <% } %>

    <!-- Tombol Next -->
    <% if (currentPage < 20) { %>
        <a href="/?q=<%= query %>&page=<%= currentPage + 1 %>">Next »</a>
    <% } %>
</div>

