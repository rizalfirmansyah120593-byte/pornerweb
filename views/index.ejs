<!doctype html>
<html lang='<%= lang %>'>
<head>
    <%- include('partials/google-tag') %>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%- include('partials/seo-head') %>
    <link rel='stylesheet' href='/css/site.css'>
</head>
<body>
    <%- include('partials/header') %>
    <div class='layout'>
        <aside class='sidebar' id='site-sidebar'>
            <div class='sidebar-scroll-area'>
                <%- include('partials/sidebar') %>
            </div>
        </aside>

        <main id='main-content' class='content'>
            <section class='page-hero'>
                <div>
                    <span class='eyebrow'><%= t.collection %></span>
                    <h1><%= title %></h1>
                    <p class='intro'><%= intro %></p>
                    <div class='hero-actions'>
                        <a class='hero-primary-cta' href='/?q=popular'>Watch now</a>
                        <a class='hero-secondary-cta' href='/?q=trending'>Trending</a>
                    </div>
                </div>
                <div class='hero-stat' aria-label='<%= data.length %> video pada halaman ini'>
                    <strong><%= data.length %></strong>
                    <span><%= t.available %></span>
                </div>
            </section>

            <% if (data.length) { %>
                <section class='featured-banner' aria-label='Featured categories'>
                    <div class='featured-banner__content'>
                        <span class='featured-pill'>Hot picks</span>
                        <h2><%= title %></h2>
                        <p>Browse the latest collection with cinematic previews and instant access.</p>
                    </div>
                    <a class='featured-cta' href='/?q=popular'>Watch now</a>
                </section>

                <%- include('partials/ad-banner-728') %>
                <%- include('partials/ad-banner-320') %>

                <div class='listing-tools'><a href='?source=all'>Semua</a><a href='?source=pornhub'>Pornhub</a><a href='?source=eporner'>Eporner</a><a href='/random'>Random Video</a></div>
                <section class='video-grid' id='video-grid' aria-label='<%= title %>'>
                    <% data.forEach((item, index) => { %>
                        <article class='video-card' data-preview-id='<%= item.id || item.viewKey || item.video_id || "" %>'>
                            <a href='<%= videoPath(item) %>'>
                                <div class='thumbnail'>
                                    <img src='<%= item.preview %>' alt='Thumbnail <%= item.title %>' width='320' height='180' loading='<%= index < 4 ? 'eager' : 'lazy' %>' decoding='async'>
                                    <video class='hover-preview' muted playsinline preload='metadata' poster='<%= item.preview %>' aria-hidden='true'></video>
                                    <span class='play-indicator' aria-hidden='true'></span>
                                    <% if (item.duration) { %><span class='duration'><%= item.duration %></span><% } %>
                                </div>
                                <div class='card-body'>
                                    <h2><%= item.title %></h2>
                                    <div class='card-meta'>
                                        <% if (item.views) { %><span><%= item.views %> views</span><% } %>
                                        <span class='watch-label'><%= t.watchNow %></span>
                                    </div>
                                    <button class='watch-later-button' type='button' data-watch-later='<%= item.id %>'>♡ Simpan</button>
                                </div>
                            </a>
                        </article>
                    <% }) %>
                </section>
            <% } else { %>
                <div class='empty'>
                    <span class='empty-icon' aria-hidden='true'>!</span>
                    <strong><%= t.noVideos %></strong>
                    <p><%= t.tryAnother %></p>
                </div>
            <% } %>

            <% if (data.length) { %>
                <%- include('partials/ad-native-banner') %>
            <% } %>

            <% if (totalPages > 1) { %>
                <% const maxVisiblePages = 10; %>
                <% const halfWindow = Math.floor(maxVisiblePages / 2); %>
                <% const startPage = Math.max(1, Math.min(currentPage - halfWindow, totalPages - maxVisiblePages + 1)); %>
                <% const endPage = Math.min(totalPages, startPage + maxVisiblePages - 1); %>
                <nav class='pagination' aria-label='Navigasi halaman'>
                    <% if (currentPage > 1) { %><a class='page-nav' rel='prev' href='<%= paginationPath(currentPage - 1) %>'>← <%= t.previous %></a><% } %>
                    <% for (let page = startPage; page <= endPage; page += 1) { %>
                        <a href='<%= paginationPath(page) %>' <% if (page === currentPage) { %>aria-current='page'<% } %>><%= page %></a>
                    <% } %>
                    <% if (currentPage < totalPages) { %><a class='page-nav' rel='next' href='<%= paginationPath(currentPage + 1) %>'><%= t.next %> →</a><% } %>
                </nav>
            <% } %>
        </main>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/ad-global') %>
    <script>
        (() => {
            if (!window.matchMedia('(hover: hover)').matches) return;
            const cards = document.querySelectorAll('[data-preview-id]');
            cards.forEach((card) => {
                const video = card.querySelector('.hover-preview');
                const id = card.dataset.previewId;
                if (!video || !id) return;
                let hoverTimer;
                let hoverToken = 0;
                card.addEventListener('pointerenter', () => {
                    hoverToken += 1;
                    const token = hoverToken;
                    hoverTimer = window.setTimeout(async () => {
                        try {
                            if (!video.src) {
                                const response = await fetch('/api/video-preview/' + encodeURIComponent(id));
                                if (!response.ok || token !== hoverToken) return;
                                const source = await response.json();
                                video.src = source.url;
                                video.type = source.type || '';
                                video.load();
                            }
                            if (token !== hoverToken) return;
                            video.currentTime = 0;
                            await video.play();
                            card.classList.add('is-previewing');
                        } catch (_) { /* preview unavailable or autoplay is blocked */ }
                    }, 180);
                });
                card.addEventListener('pointerleave', () => {
                    window.clearTimeout(hoverTimer);
                    hoverToken += 1;
                    video.pause();
                    video.currentTime = 0;
                    card.classList.remove('is-previewing');
                });
            });
        })();
    </script>
    <script>
    (() => {
        const read = (key) => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
        const write = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
        document.querySelectorAll('[data-watch-later]').forEach((button) => {
            const id = button.dataset.watchLater;
            const saved = read('pornerwebWatchLater');
            if (saved.includes(id)) button.classList.add('is-saved');
            button.addEventListener('click', (event) => {
                event.preventDefault(); event.stopPropagation();
                const list = read('pornerwebWatchLater');
                const next = list.includes(id) ? list.filter((item) => item !== id) : [...list, id];
                write('pornerwebWatchLater', next); button.classList.toggle('is-saved', next.includes(id));
            });
        });
        const grid = document.getElementById('video-grid');
        if (!grid) return;
        const nextLink = document.querySelector('.pagination a[rel="next"]');
        if (!nextLink || !('IntersectionObserver' in window)) return;
        const sentinel = document.createElement('div'); sentinel.className = 'infinite-scroll-sentinel'; grid.after(sentinel);
        let loading = false;
        const observer = new IntersectionObserver(async ([entry]) => {
            if (!entry.isIntersecting || loading) return;
            loading = true;
            try {
                const html = await (await fetch(nextLink.href)).text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                doc.querySelectorAll('#video-grid > .video-card').forEach((card) => grid.append(card));
                const newer = doc.querySelector('.pagination a[rel="next"]');
                if (newer) nextLink.href = newer.href; else { observer.disconnect(); sentinel.remove(); }
            } catch {} finally { loading = false; }
        }, { rootMargin: '500px' });
        observer.observe(sentinel);
    })();
    </script>
</body>
</html>
