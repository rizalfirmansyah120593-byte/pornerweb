<!doctype html>
<html lang='<%= lang %>'>
<head>
    <%- include('partials/google-tag') %>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%- include('partials/seo-head') %>
    <% if (data && data.length && data[0].preview) { %>
    <link rel='preload' as='image' href='<%= data[0].preview %>' fetchpriority='high'>
    <% } %>
    <link rel='stylesheet' href='/css/site.css'>
</head>
<body>
    <%- include('partials/header') %>
    <div class='layout'>
        <aside class='sidebar' id='site-sidebar'>
            <div class='sidebar-scroll-area'>
                <%- include('partials/sidebar') %>
            </div>
        </aside>

        <main id='main-content' class='content'>
            <section class='page-hero'>
                <div>
                    <span class='eyebrow'><%= t.collection %></span>
                    <h1><%= title %></h1>
                    <p class='intro'><%= intro %></p>
                    <div class='hero-bottom-row'>
                        <div class='hero-actions'>
                            <a class='hero-secondary-cta' href='/?q=trending'>Trending</a>
                        </div>
                        <div class='hero-stat' aria-label='<%= data.length %> video pada halaman ini'>
                            <strong><%= data.length %></strong>
                            <span><%= t.available %></span>
                        </div>
                    </div>
                </div>
            </section>

            <% if (data.length) { %>
                <section class='featured-banner about-pornerweb is-collapsed' id='about-pornerweb' aria-label='Tentang PORNERWEB'>
                    <% const aboutPornerweb = {
                        id: { badge: 'Tentang PORNERWEB', title: 'Temukan koleksi video dewasa pilihan', text: 'PORNERWEB adalah platform pencarian dan penemuan video dewasa 18+ yang membantu Anda menemukan koleksi populer dari berbagai sumber dalam satu pengalaman browsing yang rapi. Jelajahi video berdasarkan kategori, negara, popularitas, dan kata kunci dengan thumbnail, durasi, serta informasi yang mudah dipahami. Koleksi diperbarui secara berkala agar Anda dapat menemukan konten baru dengan lebih cepat dan nyaman.' },
                        en: { badge: 'About PORNERWEB', title: 'Discover a curated adult video collection', text: 'PORNERWEB is an 18+ adult video discovery platform built to help you explore popular collections from multiple sources in one clean browsing experience. Find videos by category, country, popularity, and keywords with clear thumbnails, durations, and useful details. Our collection is refreshed regularly so you can discover new content quickly and enjoy a smoother, more organized viewing experience.' },
                        ms: { badge: 'Tentang PORNERWEB', title: 'Temui koleksi video dewasa pilihan', text: 'PORNERWEB ialah platform penemuan video dewasa 18+ yang membantu anda meneroka koleksi popular daripada pelbagai sumber dalam pengalaman carian yang kemas. Cari video mengikut kategori, negara, populariti dan kata kunci dengan thumbnail, tempoh serta maklumat yang jelas. Koleksi dikemas kini secara berkala supaya anda dapat menemui kandungan baharu dengan lebih cepat dan selesa.' },
                        es: { badge: 'Sobre PORNERWEB', title: 'Descubre una colección de vídeos para adultos', text: 'PORNERWEB es una plataforma para descubrir vídeos para adultos mayores de 18 años, creada para explorar colecciones populares de varias fuentes en una experiencia ordenada. Encuentra vídeos por categoría, país, popularidad y palabras clave con miniaturas, duración y detalles claros. La colección se actualiza regularmente para ayudarte a descubrir contenido nuevo de forma rápida y cómoda.' },
                        ja: { badge: 'PORNERWEBについて', title: '厳選されたアダルト動画を見つける', text: 'PORNERWEBは、18歳以上のユーザー向けに、複数のソースから人気のアダルト動画を探せるプラットフォームです。カテゴリー、国、人気度、キーワードから動画を検索でき、サムネイルや再生時間などの情報もわかりやすく表示します。コレクションは定期的に更新され、新しいコンテンツを快適に見つけられます。' }
                    }[lang] || aboutPornerweb.en; %>
                    <% const aboutToggle = ({
                        id: { more: 'Tampilkan semua', less: 'Sembunyikan' },
                        en: { more: 'Show more', less: 'Show less' },
                        ms: { more: 'Papar lagi', less: 'Sembunyikan' },
                        es: { more: 'Ver más', less: 'Ver menos' },
                        ja: { more: 'もっと見る', less: '閉じる' },
                    }[lang] || { more: 'Show more', less: 'Show less' }); %>
                    <div class='featured-banner__content'>
                        <span class='featured-pill'><%= aboutPornerweb.badge %></span>
                        <h2><%= aboutPornerweb.title %></h2>
                        <p class='about-pornerweb__text'><%= aboutPornerweb.text %></p>
                    </div>
                    <div class='about-pornerweb__actions'>
                        <button class='btn about-pornerweb__toggle' type='button' id='about-pornerweb-toggle' aria-expanded='false' data-more='<%= aboutToggle.more %>' data-less='<%= aboutToggle.less %>'><%= aboutToggle.more %></button>
                    </div>
                </section>

                <%- include('partials/ad-banner-728') %>
                <%- include('partials/ad-banner-320') %>

                <div class='listing-tools'>
                    <a class='<%= sourceFilter === "all" ? "is-active" : "" %>' href='<%= sourceFilterBase %>all'>Semua</a>
                    <a class='<%= sourceFilter === "pornhub" ? "is-active" : "" %>' href='<%= sourceFilterBase %>pornhub'>Pornhub</a>
                    <a class='<%= sourceFilter === "eporner" ? "is-active" : "" %>' href='<%= sourceFilterBase %>eporner'>Eporner</a>
                    <a class='<%= sourceFilter === "random" ? "is-active" : "" %>' href='/random'>✦ Viral</a>
                </div>
                <section class='video-grid' id='video-grid' aria-label='<%= title %>'>
                    <% data.forEach((item, index) => { %>
                        <article class='video-card' data-preview-id='<%= item.id || item.viewKey || item.video_id || "" %>'>
                            <a href='<%= videoPath(item) %>'>
                                <div class='thumbnail'>
                                    <picture>
                                        <% if (item.previewWebp) { %><source srcset='<%= item.previewWebp %>' type='image/webp'><% } %>
                                        <img src='<%= item.preview %>' alt='Thumbnail <%= item.title %>' width='320' height='180' loading='<%= index === 0 ? 'eager' : 'lazy' %>' fetchpriority='<%= index === 0 ? 'high' : 'auto' %>' decoding='async'>
                                    </picture>
                                    <video class='hover-preview' muted playsinline preload='metadata' poster='<%= item.preview %>' aria-hidden='true'></video>
                                    <span class='play-indicator' aria-hidden='true'></span>
                                    <% if (item.duration) { %><span class='duration'><%= item.duration %></span><% } %>
                                </div>
                                <div class='card-body'>
                                    <h2><%= item.title %></h2>
                                    <div class='card-meta'>
                                        <% if (item.views) { %><span><%= item.views %> views</span><% } %>
                                    </div>
                                    <button class='watch-later-button' type='button' data-watch-later='<%= item.id %>'>♡ Simpan</button>
                                </div>
                            </a>
                        </article>
                    <% }) %>
                </section>
            <% } else { %>
                <div class='empty'>
                    <span class='empty-icon' aria-hidden='true'>!</span>
                    <strong><%= t.noVideos %></strong>
                    <p><%= t.tryAnother %></p>
                </div>
            <% } %>

            <% if (data.length) { %>
                <%- include('partials/ad-native-banner') %>
            <% } %>

            <% if (totalPages > 1) { %>
                <% const pageBlockStart = Math.floor((currentPage - 1) / 10) * 10 + 1; %>
                <% const pageBlockEnd = Math.min(pageBlockStart + 9, totalPages); %>
                <nav class='pagination' aria-label='Navigasi halaman'>
                    <% if (currentPage > 1) { %><a class='page-nav' rel='prev' href='<%= paginationPath(currentPage - 1) %>'>← <%= t.previous %></a><% } %>
                    <% for (let page = pageBlockStart; page <= pageBlockEnd; page += 1) { %>
                        <a class='<%= page === currentPage ? 'is-current' : '' %>' href='<%= paginationPath(page) %>' <% if (page === currentPage) { %>aria-current='page'<% } %>><%= page %></a>
                    <% } %>
                    <% if (currentPage < totalPages) { %><a class='page-nav' rel='next' href='<%= paginationPath(currentPage + 1) %>'><%= t.next %> →</a><% } %>
                </nav>
            <% } %>

            <% if (typeof trendingPornstars !== 'undefined' && trendingPornstars.length) { %>
                <section class='trending-pornstars' aria-label='Trending Pornstars'>
                    <div class='section-heading'>
                        <div><h2>Trending Pornstars</h2><p>Four popular models picked for you.</p></div>
                        <a href='/pornstars'>View all</a>
                    </div>
                    <div class='pornstar-grid'>
                        <% trendingPornstars.forEach((star) => { %>
                            <article class='pornstar-card'>
                                <a class='pornstar-card__photo' href='/?q=<%= encodeURIComponent(star.name) %>' aria-label='Lihat video <%= star.name %>'>
                                <img src='<%= star.photo || "/images/placeholder.svg" %>' alt='<%= star.name %>' width='320' height='240' loading='lazy' decoding='async' onerror="this.onerror=null;this.src='/images/placeholder.svg';">
                                </a>
                                <div class='pornstar-card__body'><h2><a href='/?q=<%= encodeURIComponent(star.name) %>'><%= star.name %></a></h2></div>
                            </article>
                        <% }) %>
                    </div>
                </section>
            <% } %>

            <% const pornerBlog = {
                id: { title: 'Blog PORNERWEB', subtitle: 'Panduan dan informasi seputar video dewasa 18+', intro: 'PORNERWEB membantu pengunjung dewasa menemukan koleksi video populer dari berbagai sumber dengan cara yang lebih rapi, cepat, dan nyaman. Gunakan kategori, pencarian, filter sumber, serta rekomendasi untuk menemukan konten yang sesuai dengan minat Anda.', cards: [['Cara menemukan video yang sesuai', 'Gunakan kata kunci, kategori, negara, dan filter sumber untuk mempersempit hasil pencarian. Sistem kami menggabungkan metadata video agar penjelajahan terasa lebih praktis.'], ['Menjelajahi koleksi dari berbagai sumber', 'PORNERWEB mengumpulkan informasi dari Pornhub dan Eporner dalam satu tampilan. Setiap sumber memiliki player dan metadata masing-masing sehingga Anda dapat memilih pengalaman menonton yang paling sesuai.'], ['Tips menikmati pengalaman browsing yang nyaman', 'Manfaatkan fitur Continue Watching, Watch Later, Random Video, serta rekomendasi untuk melanjutkan penjelajahan tanpa harus mengulang pencarian dari awal.'], ['Konten khusus pengunjung dewasa', 'Seluruh konten PORNERWEB ditujukan untuk pengguna berusia 18 tahun ke atas. Gunakan website secara bertanggung jawab dan patuhi hukum yang berlaku di wilayah Anda.']], seoTitle: 'Temukan Video Dewasa 18+ dengan Pencarian yang Lebih Teratur', seoParagraphs: ['PORNERWEB adalah situs pencarian dan penemuan video dewasa 18+ yang membantu pengunjung menemukan koleksi video dari berbagai sumber dalam satu pengalaman browsing yang sederhana. Halaman ini dirancang untuk memudahkan pencarian berdasarkan kata kunci, kategori, negara, model, pornstar, popularitas, dan sumber video. Setiap hasil dilengkapi informasi seperti judul, thumbnail, durasi, jumlah tayangan, tag, serta tautan menuju halaman tontonan.', 'Gunakan kotak pencarian untuk memasukkan topik atau nama yang ingin ditemukan. Anda juga dapat memilih kategori dan filter sumber agar hasil pencarian lebih relevan. Navigasi yang jelas membantu Anda berpindah dari video populer ke video terbaru, rekomendasi, model populer, pornstar, kategori, dan koleksi berdasarkan negara tanpa harus membuka banyak situs secara bersamaan.', 'PORNERWEB menampilkan metadata dan pemutar embed dari sumber yang tersedia. Video diputar melalui player sumber terkait sehingga pengguna dapat memperoleh pengalaman tontonan yang lebih konsisten. Thumbnail, judul, tag, durasi, dan jumlah views membantu Anda memilih video sebelum membukanya. Gunakan fitur Watch Later untuk menyimpan pilihan dan Continue Watching untuk melanjutkan sesi browsing dari video yang terakhir dibuka.', 'Seluruh halaman dan fitur pada PORNERWEB ditujukan khusus untuk pengguna berusia 18 tahun ke atas. Akses konten secara bertanggung jawab, hormati hak cipta, privasi, persetujuan, serta peraturan yang berlaku di wilayah Anda. PORNERWEB berfokus pada pengorganisasian informasi dan penemuan konten, sehingga setiap pengguna tetap perlu memastikan bahwa penggunaan layanan sesuai dengan hukum dan ketentuan sumber video.'] },
                en: { title: 'PORNERWEB Blog', subtitle: 'Guides and insights for adult video discovery', intro: 'PORNERWEB helps adult visitors discover popular video collections from multiple sources in a cleaner, faster, and more comfortable experience. Use categories, search, source filters, and recommendations to find content that matches your interests.', cards: [['How to find the right videos', 'Use keywords, categories, countries, and source filters to narrow your results. Our interface brings useful video metadata together to make browsing more practical.'], ['Explore multiple video sources', 'PORNERWEB combines information from Pornhub and Eporner in one organized interface. Each source keeps its own player and metadata for a reliable viewing experience.'], ['Tips for a better browsing experience', 'Use Continue Watching, Watch Later, Random Video, and personalized recommendations to keep exploring without repeating the same search.'], ['For adult visitors only', 'All PORNERWEB content is intended for visitors aged 18 and over. Browse responsibly and follow the laws that apply in your region.']], seoTitle: 'Discover 18+ Adult Videos with Organized Search', seoParagraphs: ['PORNERWEB is an 18+ adult video discovery website that brings useful information from available sources into one organized browsing experience. Visitors can explore videos by keyword, category, country, model, pornstar, popularity, and source. Each listing may include a title, thumbnail, duration, views, tags, and a link to the relevant viewing page.', 'Use the search box to find a specific topic, name, or phrase. Source filters and category navigation help narrow results and make discovery more efficient. You can move between popular videos, latest uploads, recommendations, models, pornstars, country collections, and curated categories without repeating the same search on several websites.', 'PORNERWEB presents metadata and embeds from the relevant source. The video player remains connected to its source, while the surrounding interface makes titles, thumbnails, durations, tags, and viewing choices easier to compare. Watch Later helps save interesting results, and Continue Watching helps resume a previous browsing session.', 'All PORNERWEB pages are intended for adults aged 18 and over. Browse responsibly and respect copyright, privacy, consent, and the laws that apply in your location. Users should verify that their access and use of every source complies with the source terms and applicable regulations.'] },
                ms: { title: 'Blog PORNERWEB', subtitle: 'Panduan penemuan video dewasa 18+', intro: 'PORNERWEB membantu pengunjung dewasa meneroka koleksi video popular daripada pelbagai sumber dengan pengalaman yang kemas dan selesa.', cards: [['Cara mencari video yang sesuai', 'Gunakan kata kunci, kategori, negara dan penapis sumber untuk mendapatkan hasil yang lebih tepat.'], ['Terokai pelbagai sumber video', 'PORNERWEB menggabungkan maklumat daripada Pornhub dan Eporner dalam satu paparan yang teratur.'], ['Pengalaman carian yang lebih selesa', 'Gunakan Continue Watching, Watch Later dan Random Video untuk meneruskan carian dengan mudah.'], ['Untuk pengunjung dewasa sahaja', 'Semua kandungan PORNERWEB ditujukan kepada pengunjung berumur 18 tahun ke atas.']] },
                es: { title: 'Blog de PORNERWEB', subtitle: 'Guías para descubrir vídeos para adultos', intro: 'PORNERWEB ayuda a los visitantes adultos a descubrir colecciones populares de varias fuentes en una experiencia más rápida y organizada.', cards: [['Cómo encontrar los vídeos adecuados', 'Usa palabras clave, categorías, países y filtros de fuente para encontrar resultados más precisos.'], ['Explora varias fuentes de vídeo', 'PORNERWEB reúne información de Pornhub y Eporner en una interfaz organizada.'], ['Una experiencia de navegación más cómoda', 'Utiliza Continue Watching, Watch Later y Random Video para continuar explorando.'], ['Solo para visitantes adultos', 'Todo el contenido está destinado a personas mayores de 18 años.']] },
                ja: { title: 'PORNERWEB ブログ', subtitle: 'アダルト動画を探すためのガイド', intro: 'PORNERWEBは、複数のソースから人気のアダルト動画を整理して探せる、18歳以上向けのプラットフォームです。', cards: [['動画を見つける方法', 'キーワード、カテゴリー、国、ソースフィルターを使って目的の動画を探せます。'], ['複数の動画ソースを探索', 'PornhubとEpornerの情報を整理されたインターフェースで確認できます。'], ['快適なブラウジング', 'Continue Watching、Watch Later、Random Videoで探索を続けられます。'], ['成人向けコンテンツ', 'PORNERWEBのコンテンツは18歳以上のユーザーを対象としています。']] }
            }[lang] || pornerBlog.en; %>
            <section class='porner-blog' aria-labelledby='porner-blog-title'>
                <div class='porner-blog__heading'><span class='eyebrow'>PORNERWEB INSIGHTS</span><h2 id='porner-blog-title'><%= pornerBlog.title %></h2><p><%= pornerBlog.subtitle %></p></div>
                <p class='porner-blog__intro'><%= pornerBlog.intro %></p>
                <div class='porner-blog__grid'>
                    <% const homepageBlogPosts = (typeof blogPosts !== 'undefined' && blogPosts.length) ? blogPosts : pornerBlog.cards.map(([title, summary], idx) => ({ slug: ['cara-menemukan-video-yang-sesuai', 'menjelajahi-koleksi-dari-berbagai-sumber', 'tips-menikmati-browsing-yang-nyaman', 'konten-khusus-pengunjung-dewasa'][idx], title, summary })); %>
                    <% homepageBlogPosts.forEach((post) => { %>
                        <article>
                            <h3><a href='/blog/<%= post.slug %>'><%= post.title %></a></h3>
                            <p><%= post.summary %></p>
                        </article>
                    <% }) %>
                </div>
            </section>
            <section class='seo-description' aria-labelledby='seo-description-title'>
                <span class='eyebrow'>PORNERWEB</span>
                <% const seoTitle = pornerBlog.seoTitle || pornerBlog.title; %>
                <% const seoParagraphs = pornerBlog.seoParagraphs || [pornerBlog.intro, ...pornerBlog.cards.map((card) => card[1])]; %>
                <h2 id='seo-description-title'><%= seoTitle %></h2>
                <% seoParagraphs.forEach((paragraph) => { %><p><%= paragraph %></p><% }) %>
            </section>
            <%- include('partials/ad-native-banner') %>
        </main>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/ad-global') %>
    <script>
        (() => {
            if (!window.matchMedia('(hover: hover)').matches) return;
            const cards = document.querySelectorAll('[data-preview-id]');
            cards.forEach((card) => {
                const video = card.querySelector('.hover-preview');
                const id = card.dataset.previewId;
                if (!video || !id) return;
                let hoverTimer;
                let hoverToken = 0;
                card.addEventListener('pointerenter', () => {
                    hoverToken += 1;
                    const token = hoverToken;
                    hoverTimer = window.setTimeout(async () => {
                        try {
                            if (!video.src) {
                                const response = await fetch('/api/video-preview/' + encodeURIComponent(id));
                                if (!response.ok || token !== hoverToken) return;
                                const source = await response.json();
                                video.src = source.url;
                                video.type = source.type || '';
                                video.load();
                            }
                            if (token !== hoverToken) return;
                            video.currentTime = 0;
                            await video.play();
                            card.classList.add('is-previewing');
                        } catch (_) { /* preview unavailable or autoplay is blocked */ }
                    }, 180);
                });
                card.addEventListener('pointerleave', () => {
                    window.clearTimeout(hoverTimer);
                    hoverToken += 1;
                    video.pause();
                    video.currentTime = 0;
                    card.classList.remove('is-previewing');
                });
            });
        })();
    </script>
    <script>
    (() => {
        const read = (key) => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
        const write = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
        document.querySelectorAll('[data-watch-later]').forEach((button) => {
            const id = button.dataset.watchLater;
            const saved = read('pornerwebWatchLater');
            if (saved.includes(id)) button.classList.add('is-saved');
            button.addEventListener('click', (event) => {
                event.preventDefault(); event.stopPropagation();
                const list = read('pornerwebWatchLater');
                const next = list.includes(id) ? list.filter((item) => item !== id) : [...list, id];
                write('pornerwebWatchLater', next); button.classList.toggle('is-saved', next.includes(id));
            });
        });
    })();
    </script>
    <script>
    (() => {
        const root = document.getElementById('about-pornerweb');
        const toggle = document.getElementById('about-pornerweb-toggle');
        if (!root || !toggle) return;
        const key = 'pornerwebAboutExpanded';
        const setExpanded = (expanded) => {
            root.classList.toggle('is-collapsed', !expanded);
            toggle.setAttribute('aria-expanded', String(expanded));
            toggle.textContent = expanded ? (toggle.dataset.less || 'Show less') : (toggle.dataset.more || 'Show more');
            try { localStorage.setItem(key, expanded ? 'true' : 'false'); } catch (_) {}
        };
        let expanded = false;
        try { expanded = localStorage.getItem(key) === 'true'; } catch (_) {}
        setExpanded(expanded);
        toggle.addEventListener('click', () => setExpanded(!(toggle.getAttribute('aria-expanded') === 'true')));
    })();
    </script>
</body>
</html>
