    <style>
        /* --- Variabel Warna --- */
        :root {
            --bg-color: #161616;
            --text-color: #ffffff;
            --accent-color: #ff4500;
            --sidebar-bg: #161616;
            --card-bg: #1e1e1e;
        }

        .light-mode {
            --bg-color: #f4f4f4;
            --text-color: #161616;
            --accent-color: #d13a00;
            --sidebar-bg: #e0e0e0;
            --card-bg: #ffffff;
        }

        /* --- Global Reset --- */
        body { 
            margin: 0; 
            font-family: 'Inter', sans-serif; 
            background-color: var(--bg-color); 
            color: var(--text-color); 
            transition: background 0.3s, color 0.3s;
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Memaksa halaman memenuhi tinggi layar */
        }

        /* --- Layout Utama --- */
        aside {
            width: 260px;
            height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #333;
            z-index: 1001;
        }

        header {
            position: fixed;
            margin-left: 260px;
            padding: 15px 30px;
            background: #1a1a1a;;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            width: 77%;
            top: 0;
            left: 0;
        }

        main {
            margin-left: 260px;
            padding: 40px;
            flex: 1;
        }

        /* --- Sidebar & Scroll --- */
        .logo { 
            padding: 25px; font-size: 22px; font-weight: 800; color: var(--accent-color); 
        }
        .logo-link {
        text-decoration: none;
        color: inherit; /* agar warna teks tetap mengikuti desain */
        }

        .scroll-container {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }
        .scroll-container::-webkit-scrollbar { width: 5px; }
        .scroll-container::-webkit-scrollbar-thumb { background: #555; border-radius: 10px; }

        /* --- Menu & Card --- */
        .menu-title { font-weight: bold; color: var(--accent-color); padding: 10px; cursor: pointer; list-style: none; user-select: none; }
        .menu-item { display: block; color: var(--text-color); text-decoration: none; padding: 8px 10px; border-radius: 5px; font-size: 0.9rem; opacity: 0.7; }
        .menu-item:hover { background: #333; opacity: 1; }
        
        .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 25px; }
        .card { background: var(--card-bg); border-radius: 12px; overflow: hidden; cursor: pointer; border: 1px solid #333; transition: 0.2s; }
        .card:hover { transform: translateY(-5px); }
        .card img { width: 100%; height: 140px; object-fit: cover; }
        .card h4 { padding: 10px; font-size: 0.9rem; }

        /* --- Search & Controls --- */
        .search-box input { padding: 8px; border-radius: 4px; border: none; width: 200px; }
        .controls { display: flex; gap: 10px; }
        /* Styling Header agar rapi */
        .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 30px;
        background: #222;
        gap: 20px; /* Jarak antar elemen */
    }

        /* Membuat Search Bar fleksibel */
        .search-box {
        display: flex;
        flex-grow: 1; /* Mengisi ruang kosong */
        max-width: 600px; /* Batas maksimal panjang */
    }

        .search-box input {
        flex-grow: 1; /* Input mengambil semua ruang */
        padding: 10px;
        border-radius: 4px 0 0 4px;
        border: 1px solid #444;
        background: #333;
        color: white;
    }
        .search-box button {
        padding: 10px 15px;
        border-radius: 0 4px 4px 0;
        border: none;
        background: var(--accent-color);
        cursor: pointer;
    }
    .pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin: 30px 0;
}

.pagination a {
    padding: 8px 16px;
    background: #222;
    color: white;
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid #444;
    transition: 0.3s;
}

.pagination a:hover {
    background: #ff6600;
    border-color: #ff6600;
}

.pagination a.active {
    background: #ff6600;
    font-weight: bold;
    border-color: #ff6600;
}

.btn-nav {
    padding: 10px 20px;
    background: #333;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    transition: 0.3s;
    font-weight: 500;
}

.btn-nav:hover {
    background: var(--accent-color); /* Menggunakan warna aksen Anda */
}

/* --- Footer yang Bagus --- */
footer {
    text-align: center;
    padding: 20px 0;      /* Diperkecil dari 40px */
    background: #1e1e1e00;
    border-top: none;
    color: #888;
    margin-top: 20px;     /* Diperkecil dari 50px */
    width: 100%;
}

footer a {
    color: var(--accent-color);
    text-decoration: none;
}
.page-container {
    max-width: 800px;
    margin: 50px auto;
    padding: 40px;
    background-color: #1e1e1e;
    border-radius: 12px;
    line-height: 1.6;
    color: #ccc;
}

.page-container h2 { color: #fff; margin-bottom: 20px; }
.page-container p { margin-bottom: 15px; }
.page-container ul { margin-left: 20px; margin-bottom: 15px; }

.duration-meta {
    font-size: 12px;
    color: #888; /* Abu-abu agar tidak terlalu kontras dengan judul */
    margin: 5px 0;
    display: flex;
    align-items: center;
    gap: 5px;
}

.duration-value {
    color: #fff; /* Angka durasi dibuat sedikit lebih terang */
    font-weight: bold;
}
/* Kontainer harus relative agar badge bisa diposisikan di dalamnya */
.thumbnail-wrapper {
    position: relative;
    width: 100%;
}
.video-title {
    margin: 0;
    padding: 0;
    line-height: 1.4;
}
/* Badge Durasi */
.duration-badge {
    position: absolute;
    bottom: 8px;    /* Jarak dari bawah */
    right: 8px;     /* Jarak dari kanan */
    background: rgba(0, 0, 0, 0.7); /* Hitam transparan */
    color: #fff;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    pointer-events: none; /* Agar tidak mengganggu klik */
    z-index: 10;          /* Agar muncul di atas gambar */
}

/* Pastikan gambar mengisi container */
.thumbnail-wrapper img {
    width: 100%;
    display: block;
    border-radius: 6px; /* opsional untuk sudut melengkung */
}
.auth-container {
    display: flex;
    gap: 12px; /* Jarak antara tombol Login dan Sign Up */
    align-items: center;
}

.btn {
    padding: 8px 16px;
    border-radius: 6px; /* Sudut tombol sedikit melengkung */
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease; /* Efek transisi halus */
}

/* Tampilan tombol Login (Gaya Outline/Ghost) */
.btn-login {
    color: #ffffff;
    border: 1px solid #444;
}

.btn-login:hover {
    background-color: #333;
    border-color: #555;
}

/* Tampilan tombol Sign Up (Gaya Accent) */
.btn-signup {
    background-color: #ff4500; /* Warna aksen (bisa Anda ganti) */
    color: white;
}

.btn-signup:hover {
    background-color: #e03d00;
    box-shadow: 0 4px 10px rgba(255, 69, 0, 0.3);
}
.view-number {
    font-weight: bold;      /* Menebalkan angka */
    font-size: 1.2em;       /* Memperbesar ukuran (1.2x lebih besar dari teks normal) */
    color: #fff;            /* Opsional: membuat angka lebih terang agar kontras */
}
/* Pastikan ini adalah wadah utama card video Anda */
.video-card {
    display: flex;
    flex-direction: column; /* Membuat elemen di dalamnya menumpuk dari atas ke bawah */
    width: 250px;           /* Berikan lebar yang wajar (sesuaikan kebutuhan) */
    margin: 10px;           /* Beri jarak antar card */
    overflow: hidden;       /* Mencegah konten meluap */
}

/* Bagian judul video */
.video-title {
    width: 100%;            /* Memastikan judul menggunakan seluruh lebar card */
    font-size: 14px;
    margin-top: 8px;
    display: block;         /* Pastikan block */
}

/* Bagian Durasi dan Views */
.video-meta {
    display: block;         /* Pastikan ini ada di bawah judul, bukan di samping */
    margin-top: 5px;
    color: #888;
}
    </style>
