    </main>

    <!-- Modal Player -->
<div id="playerModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.9); z-index:9999; justify-content:center; align-items:center;">
    <div style="width: 80%; max-width: 800px;">
        <button onclick="closePlayer()" style="color:white; background:red; border:none; padding:10px; cursor:pointer;">Tutup (X)</button>
        <iframe id="videoFrame" width="100%" height="450px" frameborder="0" allowfullscreen></iframe>
    </div>
</div>

    <script>
        function openPlayer(viewKey) {
            if (!viewKey) {
            console.error("ViewKey tidak ditemukan!");
            return;
        }
            const embedUrl = `https://www.pornhub.com/embed/${viewKey}`;
            document.getElementById('videoFrame').src = embedUrl;
            document.getElementById('playerModal').style.display = 'flex';
        }
        function closePlayer() {
            document.getElementById('videoFrame').src = '';
            document.getElementById('playerModal').style.display = 'none';
        }
        // 1. Fungsionalitas Tema
        function toggleTheme() {
        const body = document.body;
    body.classList.toggle('light-mode');
    
    // Simpan preferensi ke browser
    if(body.classList.contains('light-mode')) {
        localStorage.setItem('theme', 'light');
    } else {
        localStorage.setItem('theme', 'dark');
    }
}

        // 2. Fungsionalitas Bahasa
        function changeLang() {
            const lang = document.getElementById('language').value;
        // Mengarahkan user ke URL yang sama dengan tambahan query lang
        // Contoh: domain.com/?lang=en
        const url = new URL(window.location.href);
             url.searchParams.set('lang', lang);
            window.location.href = url.toString();
    }

// 3. Init: Pastikan tema sesuai saat halaman dibuka
window.onload = () => {
    // Terapkan Tema
    if(localStorage.getItem('theme') === 'light') {
        document.body.classList.add('light-mode');
    }

    // Tampilkan bahasa yang terpilih di dropdown
    const urlParams = new URLSearchParams(window.location.search);
    const lang = urlParams.get('lang');
    if(lang) {
        document.getElementById('language').value = lang;
    }
}
    </script>
</body>
</html>