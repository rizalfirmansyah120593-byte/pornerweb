<!doctype html>
<html lang='<%= lang %>'>
<head>
    <%- include('partials/google-tag') %>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%- include('partials/seo-head') %>
    <link rel='stylesheet' href='/css/site.css'>
</head>
<body>
    <%- include('partials/header') %>
    <div class='layout'>
        <aside class='sidebar' id='site-sidebar'>
            <div class='sidebar-scroll-area'><%- include('partials/sidebar') %></div>
        </aside>
        <main id='main-content' class='content'>
            <section class='page-hero'>
                <div>
                    <span class='eyebrow'><%= t.pornstars %></span>
                    <h1><%= ({ id: 'Pornstar Populer', en: 'Popular Pornstars', ms: 'Pornstar Popular', es: 'Pornstars populares', ja: 'Popular Pornstars' }[lang] || 'Popular Pornstars') %></h1>
                    <p class='intro'><%= ({ id: 'Jelajahi profil, ranking, dan video dari pornstar populer.', en: 'Explore profiles, rankings, and videos from popular pornstars.', ms: 'Terokai profil, ranking dan video pornstar popular.', es: 'Explora perfiles, rankings y vídeos de pornstars populares.', ja: 'Explore profiles, rankings, and videos from popular pornstars.' }[lang] || 'Explore profiles, rankings, and videos from popular pornstars.') %></p>
                </div>
                <nav class='category-tabs' aria-label='<%= ({ id: "Kategori pornstar", en: "Pornstar categories", ms: "Kategori pornstar", es: "Categorias de pornstars", ja: "ポルノスターのカテゴリ" }[lang] || "Pornstar categories") %>'>
                    <a href='/pornstars' class='<%= !gender ? "is-active" : "" %>'><%= ({ id: 'Semua', en: 'All', ms: 'Semua', es: 'Todas', ja: 'すべて' }[lang] || 'All') %></a>
                    <a href='/pornstars?gender=female' class='<%= gender === "female" ? "is-active" : "" %>'><%= ({ id: 'Wanita', en: 'Female', ms: 'Wanita', es: 'Mujeres', ja: '女性' }[lang] || 'Female') %></a>
                    <a href='/pornstars?gender=male' class='<%= gender === "male" ? "is-active" : "" %>'><%= ({ id: 'Pria', en: 'Male', ms: 'Lelaki', es: 'Hombres', ja: '男性' }[lang] || 'Male') %></a>
                </nav>
            </section>

            <% if (pornstars.length) { %>
                <section class='pornstar-grid' aria-label='Pornstar list'>
                    <% pornstars.forEach((star) => { %>
                        <article class='pornstar-card'>
                            <a class='pornstar-card__photo' href='/?q=<%= encodeURIComponent(star.name) %>' aria-label='Lihat video <%= star.name %>'>
                                <img src='<%= star.photo || "/images/placeholder.svg" %>' alt='<%= star.name %>' loading='lazy' onerror="this.onerror=null;this.src='/images/placeholder.svg';">
                            </a>
                            <div class='pornstar-card__body'>
                                <h2><a href='/?q=<%= encodeURIComponent(star.name) %>'><%= star.name %></a></h2>
                                <div class='pornstar-stats'>
                                    <span><strong>#<%= star.rank || '-' %></strong><small>Ranked</small></span>
                                    <span><strong><%= star.videoNum || 0 %></strong><small>Videos</small></span>
                                    <span><strong><%= star.likes ?? 'N/A' %></strong><small>Likes</small></span>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </section>
            <% } else { %>
                <div class='empty'><strong><%= ({ id: 'Pornstar tidak ditemukan.', en: 'No pornstars found.', ms: 'Pornstar tidak ditemui.', es: 'No se encontraron pornstars.', ja: 'No pornstars found.' }[lang] || 'No pornstars found.') %></strong></div>
            <% } %>

            <% if (totalPages > 1) { %>
                <% const pageBlockStart = Math.floor((currentPage - 1) / 10) * 10 + 1; %>
                <% const pageBlockEnd = Math.min(pageBlockStart + 9, totalPages); %>
                <nav class='pagination' aria-label='Pornstar pagination'>
                    <% if (currentPage > 1) { %><a rel='prev' href='<%= paginationPath(currentPage - 1) %>'>← Sebelumnya</a><% } %>
                    <% for (let page = pageBlockStart; page <= pageBlockEnd; page += 1) { %>
                        <a href='<%= paginationPath(page) %>' <% if (page === currentPage) { %>aria-current='page'<% } %>><%= page %></a>
                    <% } %>
                    <% if (currentPage < totalPages) { %><a rel='next' href='<%= paginationPath(currentPage + 1) %>'>Berikutnya →</a><% } %>
                </nav>
            <% } %>
        </main>
    </div>
    <%- include('partials/footer') %>
    <%- include('partials/ad-global') %>
</body>
</html>
