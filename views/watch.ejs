<!doctype html>
<html lang='<%= lang %>'>
<head>
    <%- include('partials/google-tag') %>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%- include('partials/seo-head') %>
    <link rel='stylesheet' href='/css/site.css'>
    
</head>
<body>
    <%- include('partials/header') %>
    <div class='layout'>
        <aside class='sidebar' id='site-sidebar'>
            <div class='sidebar-scroll-area'>
                <%- include('partials/sidebar') %>
            </div>
        </aside>

        <main id='main-content' class='watch-content'>
            <a class='back-link' href='/'>← <%= t.back %></a>
            <div class='watch-heading'>
                <span class='eyebrow'><%= t.watching %></span>
                <h1><%= video.title %></h1>
                <button class='watch-later-button' type='button' data-watch-later='<%= video.id %>'>♡ Simpan untuk nanti</button>
            </div>
            <div id='watch-metadata' data-video-id='<%= video.id %>' data-video-title='<%= video.title.replace(/'/g, "&#39;") %>' hidden></div>

            <div class='player'>
                <button class='donation-play-gate' id='donation-play-gate' type='button'>▶ Klik untuk mulai menonton</button>
                <iframe
                    id='video-embed-frame'
                    src='<%= video.embed || `https://www.pornhub.com/embed/${video.id}` %>'
                    title='<%= video.title %>'
                    allow='autoplay; fullscreen; picture-in-picture; encrypted-media'
                    allowfullscreen
                    referrerpolicy='no-referrer-when-downgrade'
                    loading='lazy'></iframe>
                <% if (Array.isArray(video.mediaDefinitions) && video.mediaDefinitions.length) { %>
                    <video id='desktop-video-fallback' class='desktop-video-fallback' controls playsinline preload='metadata' poster='<%= video.preview || video.thumb || "" %>' aria-label='<%= video.title %>'>
                        <% video.mediaDefinitions.slice().sort((a, b) => Number(b.quality || 0) - Number(a.quality || 0)).forEach((media) => { %>
                            <% const mediaFormat = String(media.format || '').toLowerCase(); %>
                            <% if (mediaFormat === 'mp4' || mediaFormat === 'webm' || mediaFormat === 'ogg') { %>
                                <source src='<%= media.videoUrl %>' type='video/<%= mediaFormat %>'>
                            <% } %>
                        <% }) %>
                    </video>
                    <p id='desktop-video-error' class='desktop-video-error' hidden>Video tidak dapat diputar oleh browser ini. Silakan coba refresh atau gunakan browser lain.</p>
                <% } %>
            </div>

            <div class='donation-modal' id='donation-modal' hidden role='dialog' aria-modal='true' aria-labelledby='donation-modal-title'>
                <div class='donation-modal__box'>
                    <button class='donation-modal__close' id='donation-modal-close' type='button' aria-label='Tutup'>×</button>
                    <span class='eyebrow'><%= localized(lang, { id: 'Dukung PORNERWEB', en: 'Support PORNERWEB', ms: 'Sokong PORNERWEB', es: 'Apoya PORNERWEB', ja: 'PORNERWEBを支援' }) %></span>
                    <h2 id='donation-modal-title'><%= localized(lang, { id: 'Bantu website ini tetap berjalan', en: 'Help keep this website running', ms: 'Bantu laman web ini terus berjalan', es: 'Ayuda a mantener este sitio activo', ja: 'このサイトの運営を支援してください' }) %></h2>
                    <p><%= localized(lang, { id: 'Dukungan Anda membantu membayar server dan mengembangkan fitur baru untuk PORNERWEB.', en: 'Your support helps pay for the server and develop new PORNERWEB features.', ms: 'Sokongan anda membantu membayar pelayan dan membangunkan ciri baharu PORNERWEB.', es: 'Tu apoyo ayuda a pagar el servidor y desarrollar nuevas funciones para PORNERWEB.', ja: '皆様の支援はサーバー費用と新機能の開発に役立ちます。' }) %></p>
                    <div class='donation-modal__actions'>
                        <a class='donation-button' href='https://saweria.co/RizalFirmansyah' target='_blank' rel='noopener noreferrer'>♥ Dukung melalui Saweria</a>
                        <button class='btn donation-modal__continue' id='donation-modal-continue' type='button'><%= localized(lang, { id: 'Lanjutkan menonton', en: 'Continue watching', ms: 'Teruskan menonton', es: 'Continuar viendo', ja: '視聴を続ける' }) %></button>
                    </div>
                </div>
            </div>

            <%- include('partials/ad-banner-468') %>
            <%- include('partials/ad-banner-320') %>


            <section class='video-info' aria-label='Informasi video'>
                <div class='video-stats'>
                    <span><small><%= t.views %></small><strong><%= video.views ? video.views.toLocaleString() : '0' %></strong></span>
                    <span><small><%= t.likes %></small><strong><%= video.vote && video.vote.up ? video.vote.up.toLocaleString() : '0' %></strong></span>
                    <span><small><%= t.duration %></small><strong><%= video.durationFormatted || 'N/A' %></strong></span>
                </div>

                <div class='description-block'>
                    <h2><%= t.aboutVideo %></h2>
                    <p><%= video.description %></p>
                </div>

                <% if (video.tags && video.tags.length) { %>
                    <h2 class='tag-title'><%= t.relatedTags %></h2>
                    <nav class='tags' aria-label='Tag video'>
                        <% video.tags.forEach((tag) => { %>
                            <a class='tag' href='/?q=<%= encodeURIComponent(tag) %>' rel='nofollow'><%= tag %></a>
                        <% }) %>
                    </nav>
                <% } %>
            </section>
            <%- include('partials/ad-native-banner') %>
            <section class="recommendations-section" aria-label="Rekomendasi video">
                <div class="section-heading">
                    <h2><%= t.recommendations %></h2>
                    <p><%= ({ id: 'Delapan pilihan acak untuk melanjutkan menonton.', en: 'Eight random picks to keep watching.', ms: 'Lapan pilihan rawak untuk terus menonton.', es: 'Ocho selecciones para seguir viendo.', ja: 'Eight random picks to keep watching.' }[lang] || 'Eight random picks to keep watching.') %></p>
                </div>

                <div class="video-grid">
                    <% if (typeof recommendations !== 'undefined' && recommendations.length > 0) { %>
                        <% recommendations.slice(0, 8).forEach(rec => { %>
                            <article class="video-card">
                                <a class="video-card-link" href="/watch/<%= rec.id %>">
                                    <div class="thumbnail">
                                        <img src="<%= rec.preview || '/images/placeholder.svg' %>" alt="<%= rec.title %>" width="320" height="180" loading="lazy">
                                    </div>
                                    <div class="card-body">
                                        <h2><%= rec.title %></h2>
                                        <% if (rec.views || rec.duration) { %>
                                            <div class="card-meta">
                                                <% if (rec.views) { %><span><%= rec.views %></span><% } %>
                                                <% if (rec.duration) { %><span><%= rec.duration %></span><% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                </a>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <p class="empty-state"><%= ({ id: 'Tidak ada rekomendasi yang tersedia saat ini.', en: 'No recommendations are available right now.', ms: 'Tiada cadangan tersedia sekarang.', es: 'No hay recomendaciones disponibles ahora.', ja: 'No recommendations are available right now.' }[lang] || 'No recommendations are available right now.') %></p>
                    <% } %>
                </div>
            </section>
            <% const recommendationItems = (video && (video.recommended || video.recommendations)) || (typeof recommended !== 'undefined' ? recommended : (typeof recommendations !== 'undefined' ? recommendations.slice(8) : [])); %>
            <section class='recommendations-section more-videos-section' aria-labelledby='recommended-title' data-watch-more data-video-id='<%= video.id %>' data-next-page='2'>
                    <div class='section-heading'>
                        <div>
                            <h2 id='recommended-title'>More videos to explore</h2>
                            <p>Other videos from the combined sources.</p>
                        </div>
                    </div>
                    <div class='video-grid'>
                        <% (recommendationItems || []).forEach((item) => { %>
                            <% const thumbnailUrl = item.thumbnail || item.thumb || item.image || item.preview || item.poster || item.thumbnail_url || item.thumbUrl || (item.images && item.images[0]) || (item.thumbnails && item.thumbnails[0]) || '/images/placeholder.svg'; %>
                            <article class='video-card'>
                                <a href='/watch/<%= item.id %>'>
                                    <div class='thumbnail'>
                                        <img src='<%= Array.isArray(thumbnailUrl) ? thumbnailUrl[0] : (typeof thumbnailUrl === "object" ? (thumbnailUrl.url || thumbnailUrl.src || "/images/placeholder.svg") : thumbnailUrl) %>' alt='<%= item.title %>' loading='lazy' onerror="this.onerror=null;this.src='/images/placeholder.svg';">
                                    </div>
                                    <div class='card-body'>
                                        <h2><%= item.title %></h2>
                                        <div class='card-meta'><% if (item.views) { %><span><%= Number(item.views).toLocaleString() %> views</span><% } %></div>
                                        <button class='watch-later-button' type='button' data-watch-later='<%= item.id %>'>♡ Simpan</button>
                                    </div>
                                </a>
                            </article>
                        <% }); %>
                    </div>
                    <div class='watch-more-status' data-watch-more-status aria-live='polite'></div>
                </section>
        </main>
    </div>

    <script type='module'>
        (() => {
            const metadata = document.getElementById('watch-metadata');
            const currentVideoId = metadata?.dataset.videoId || '';
            const currentVideoTitle = metadata?.dataset.videoTitle || '';
            document.querySelectorAll('.recommendations-section:not(.more-videos-section) .video-grid').forEach((strip) => {
                const controls = document.createElement('div');
                controls.className = 'recommendation-carousel-controls';
                controls.innerHTML = '<button type="button" aria-label="Geser ke kiri">←</button><button type="button" aria-label="Geser ke kanan">→</button>';
                strip.parentElement.insertBefore(controls, strip);
                const [left, right] = controls.querySelectorAll('button');
                const move = (distance) => strip.scrollBy({ left: distance, behavior: 'smooth' });
                left.addEventListener('click', () => move(-210));
                right.addEventListener('click', () => move(210));
                let timer;
                const start = () => { timer = window.setInterval(() => { if (strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 4) strip.scrollTo({ left: 0, behavior: 'smooth' }); else strip.scrollBy({ left: 1, behavior: 'auto' }); }, 35); };
                const stop = () => window.clearInterval(timer);
                strip.addEventListener('mouseenter', stop);
                strip.addEventListener('mouseleave', start);
                strip.addEventListener('touchstart', stop, { passive: true });
                strip.addEventListener('touchend', () => window.setTimeout(start, 1200), { passive: true });
                start();
            });
            const gate = document.getElementById('donation-play-gate');
            const modal = document.getElementById('donation-modal');
            const close = document.getElementById('donation-modal-close');
            const continueButton = document.getElementById('donation-modal-continue');
            let seen = false;
            try { seen = sessionStorage.getItem('pornerwebDonationPrompt') === 'true'; } catch (_) {}
            if (seen) gate?.remove();
            const dismiss = () => {
                try { sessionStorage.setItem('pornerwebDonationPrompt', 'true'); } catch (_) {}
                if (modal) modal.hidden = true;
                gate?.remove();
            };
            gate?.addEventListener('click', () => { if (modal) modal.hidden = false; });
            close?.addEventListener('click', dismiss);
            continueButton?.addEventListener('click', dismiss);
            modal?.addEventListener('click', (event) => { if (event.target === modal) dismiss(); });
            try {
                const key = 'pornerwebContinueWatching';
                const items = JSON.parse(localStorage.getItem(key) || '[]').filter((item) => item.id !== currentVideoId);
                items.unshift({ id: currentVideoId, title: currentVideoTitle, url: `/watch/${encodeURIComponent(currentVideoId)}`, updatedAt: Date.now() });
                localStorage.setItem(key, JSON.stringify(items.slice(0, 20)));
            } catch (_) {}
            const frame = document.getElementById('video-embed-frame');
            const fallback = document.getElementById('desktop-video-fallback');
            if (!frame || !fallback) return;
            const showFallback = () => {
                frame.hidden = true;
                fallback.classList.add('is-visible');
            };
            fallback.addEventListener('error', () => {
                const errorMessage = document.getElementById('desktop-video-error');
                if (errorMessage) errorMessage.hidden = false;
            });
            frame.addEventListener('error', showFallback);
            window.setTimeout(() => {
                try {
                    if (frame.contentDocument && frame.contentDocument.body && !frame.contentDocument.body.innerHTML.trim()) showFallback();
                } catch { /* cross-origin embeds are expected; keep the iframe */ }
            }, 3500);
        })();
    </script>

    <script type='module'>
    (() => {
        const section = document.querySelector('[data-watch-more]');
        const grid = section?.querySelector('.video-grid');
        const status = section?.querySelector('[data-watch-more-status]');
        if (!section || !grid) return;
        const currentId = section.dataset.videoId;
        let page = Number(section.dataset.nextPage) || 2;
        let loading = false;
        const seen = new Set([currentId, ...Array.from(grid.querySelectorAll('a[href^="/watch/"]')).map((a) => a.getAttribute('href').split('/').pop())]);
        const addVideos = (videos) => videos.forEach((item) => {
            if (!item?.id || seen.has(String(item.id))) return;
            seen.add(String(item.id));
            const article = document.createElement('article');
            article.className = 'video-card';
            const href = '/watch/' + encodeURIComponent(item.id);
            const image = item.preview || item.thumb || item.default_thumb || '/images/placeholder.svg';
            const views = item.views ? `<div class="card-meta"><span>${Number(item.views).toLocaleString()} views</span></div>` : '<div class="card-meta"></div>';
            article.innerHTML = `<a href="${href}"><div class="thumbnail"><img src="${image}" alt="${String(item.title || 'Video').replace(/"/g, '&quot;')}" width="320" height="180" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/placeholder.svg';"></div><div class="card-body"><h2>${String(item.title || 'Video')}</h2>${views}<button class="watch-later-button" type="button" data-watch-later="${String(item.id).replace(/"/g, '&quot;')}">♡ Simpan</button></div></a>`;
            grid.appendChild(article);
        });
        const loadMore = async () => {
            if (loading) return;
            loading = true;
            if (status) status.textContent = 'Memuat video lainnya…';
            try {
                const response = await fetch(`/api/watch-more/${encodeURIComponent(currentId)}?page=${page}`, { headers: { accept: 'application/json' } });
                const data = response.ok ? await response.json() : { videos: [], hasMore: false };
                addVideos(Array.isArray(data.videos) ? data.videos : []);
                page += 1;
                if (status) status.textContent = data.hasMore ? '' : 'Belum ada video tambahan saat ini.';
            } catch { if (status) status.textContent = 'Video tambahan belum tersedia.'; }
            finally { loading = false; }
        };
        const observer = new IntersectionObserver((entries) => { if (entries[0].isIntersecting) loadMore(); }, { rootMargin: '700px 0px' });
        const sentinel = document.createElement('div');
        sentinel.className = 'watch-more-sentinel';
        section.appendChild(sentinel);
        observer.observe(sentinel);
    })();
    </script>

    <script type='module'>
    (() => {
        const button = document.querySelector('[data-watch-later]');
        if (!button) return;
        let saved = []; try { saved = JSON.parse(localStorage.getItem('pornerwebWatchLater') || '[]'); } catch (_) {}
        if (saved.includes(button.dataset.watchLater)) button.classList.add('is-saved');
        button.addEventListener('click', () => {
            saved = saved.includes(button.dataset.watchLater) ? saved.filter((id) => id !== button.dataset.watchLater) : [...saved, button.dataset.watchLater];
            try { localStorage.setItem('pornerwebWatchLater', JSON.stringify(saved)); } catch (_) {}
            button.classList.toggle('is-saved', saved.includes(button.dataset.watchLater));
        });
    })();
    </script>

    <%- include('partials/footer') %>
    <%- include('partials/ad-global') %>
</body>
</html>
