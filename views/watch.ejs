<!doctype html>
<html lang='<%= lang %>'>
<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%- include('partials/seo-head') %>
    <link rel='stylesheet' href='/css/site.css'>
    
</head>
<body>
    <%- include('partials/header') %>
    <div class='layout'>
        <aside class='sidebar' id='site-sidebar'>
            <div class='sidebar-scroll-area'>
                <%- include('partials/sidebar') %>
            </div>
        </aside>

        <main id='main-content' class='watch-content'>
            <a class='back-link' href='/'>← <%= t.back %></a>
            <div class='watch-heading'>
                <span class='eyebrow'><%= t.watching %></span>
                <h1><%= video.title %></h1>
            </div>

            <div class='player'>
                <iframe src='https://www.pornhub.com/embed/<%= video.id %>' title='<%= video.title %>' allow='fullscreen; picture-in-picture' allowfullscreen loading='eager'></iframe>
            </div>

            <%- include('partials/ad-banner-468') %>

            <section class='video-info' aria-label='Informasi video'>
                <div class='video-stats'>
                    <span><small><%= t.views %></small><strong><%= video.views ? video.views.toLocaleString() : '0' %></strong></span>
                    <span><small><%= t.likes %></small><strong><%= video.vote && video.vote.up ? video.vote.up.toLocaleString() : '0' %></strong></span>
                    <span><small><%= t.duration %></small><strong><%= video.durationFormatted || 'N/A' %></strong></span>
                </div>

                <div class='description-block'>
                    <h2><%= t.aboutVideo %></h2>
                    <p><%= video.description %></p>
                </div>

                <% if (video.tags && video.tags.length) { %>
                    <h2 class='tag-title'><%= t.relatedTags %></h2>
                    <nav class='tags' aria-label='Tag video'>
                        <% video.tags.forEach((tag) => { %>
                            <a class='tag' href='/?q=<%= encodeURIComponent(tag) %>' rel='nofollow'><%= tag %></a>
                        <% }) %>
                    </nav>
                <% } %>
            </section>
            <%- include('partials/ad-native-banner') %>
            <section class="recommendations-section" aria-label="Rekomendasi video">
                <div class="section-heading">
                    <h2><%= t.recommendations %></h2>
                    <p><%= lang === 'en' ? 'Twelve random picks to keep watching.' : 'Dua belas pilihan acak untuk melanjutkan menonton.' %></p>
                </div>

                <div class="video-grid">
                    <% if (typeof recommendations !== 'undefined' && recommendations.length > 0) { %>
                        <% recommendations.forEach(rec => { %>
                            <article class="video-card">
                                <a class="video-card-link" href="/watch/<%= rec.id %>">
                                    <img src="<%= rec.preview || '/images/placeholder.svg' %>"
                                         alt="<%= rec.title %>"
                                         width="320"
                                         height="180"
                                         loading="lazy">
                                    <div class="video-card-body">
                                        <h3><%= rec.title %></h3>
                                        <% if (rec.views || rec.duration) { %>
                                            <div class="video-card-meta">
                                                <% if (rec.views) { %><span><%= rec.views %></span><% } %>
                                                <% if (rec.duration) { %><span><%= rec.duration %></span><% } %>
                                            </div>
                                        <% } %>
                                    </div>
                                </a>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <p class="empty-state"><%= lang === 'en' ? 'No recommendations are available right now.' : 'Tidak ada rekomendasi yang tersedia saat ini.' %></p>
                    <% } %>
                </div>
            </section>
        </main>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/ad-global') %>
</body>
</html>
