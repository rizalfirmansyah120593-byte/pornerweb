<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= video.title %></title>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding-top: 70px;
        }
        
        .container {
            max-width: 850px;
            margin: 0 auto;
        }
        /* Kontainer agar video responsif 16:9 */
        .video-container {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%; /* Rasio 16:9 */
            height: 0;
            background-color: #000;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }
        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }
        h1 { font-size: 22px; margin: 20px 0; }
        .meta-info {
            background: #1e1e1e;
            padding: 15px;
            border-radius: 8px;
            margin-top: 15px;
        }
        .tags { margin-top: 10px; }
        .tag-pill {
            display: inline-block;
            background: #333;
            padding: 5px 10px;
            margin: 2px;
            border-radius: 4px;
            font-size: 12px;
        }
        /* --- Sidebar & Scroll --- */
        .logo { 
            padding: 25px; font-size: 22px; font-weight: 800; color: var(--accent-color); 
        }
        .scroll-container {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
        }
        .scroll-container::-webkit-scrollbar { width: 5px; }
        .scroll-container::-webkit-scrollbar-thumb { background: #555; border-radius: 10px; }

        /* --- Menu & Card --- */
        .menu-title { font-weight: bold; color: var(--accent-color); padding: 10px; cursor: pointer; list-style: none; user-select: none; }
        .menu-item { display: block; color: var(--text-color); text-decoration: none; padding: 8px 10px; border-radius: 5px; font-size: 0.9rem; opacity: 0.7; }
        .menu-item:hover { background: #333; opacity: 1; }
        
        .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 25px; }
        .card { background: var(--card-bg); border-radius: 12px; overflow: hidden; cursor: pointer; border: 1px solid #333; transition: 0.2s; }
        .card:hover { transform: translateY(-5px); }
        .card img { width: 100%; height: 140px; object-fit: cover; }
        .card h4 { padding: 10px; font-size: 0.9rem; }

        /* --- Layout Utama --- */
        aside {
            width: 230px;
            height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #333;
            z-index: 1001;
        }
        /* Override jika class .light-mode aktif */
body.light-mode {
    background-color: #ffffff;
    color: #000000;
}

/* Contoh penyesuaian elemen lain saat Light Mode */
body.light-mode header {
    background-color: #f0f0f0;
}

body.light-mode .card {
    background-color: #e0e0e0;
}
/* --- Penyesuaian Warna untuk Light Mode --- */

/* 1. Mengubah warna teks statistik (Views, Likes, Durasi) */
body.light-mode .meta-stats {
    color: #333333 !important; /* Ubah ke abu-abu gelap/hitam */
}

/* 3. Jika ada judul section, pastikan juga terbaca */
body.light-mode h3 {
    color: #000000 !important;
}

body.light-mode .desc-content {
    color: #444444 !important; /* Teks deskripsi lebih gelap */
}
/* Pastikan tag terlihat seperti link yang bisa diklik */
.tag {
    display: inline-block;
    background: #333;
    color: white;
    padding: 5px 10px;
    border-radius: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    font-size: 12px;
    text-decoration: none; /* Menghilangkan garis bawah link */
    cursor: pointer;
    transition: background 0.2s;
}

/* Efek saat mouse diarahkan ke tag */
.tag:hover {
    background: #ff6600; /* Warna orange saat dihover */
    color: white;
}

/* Penyesuaian untuk Light Mode agar link tetap terbaca */
body.light-mode .tag {
    background-color: #e0e0e0;
    color: #000000;
    border: 1px solid #cccccc;
}

body.light-mode .tag:hover {
    background-color: #ff6600;
    color: white;
}
    </style>
</head>
