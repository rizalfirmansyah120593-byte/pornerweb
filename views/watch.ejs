    <div class="container">
    <% try { %>
        <!-- 1. Judul Video (Hanya satu kali) -->
        <h1><%= video.title %></h1>

        <!-- 2. Pemutar Video -->
        <div class="video-container">
            <iframe 
                src="https://www.pornhub.com/embed/<%= video.id %>" 
                allowfullscreen 
                scrolling="no">
            </iframe>
        </div>

        <!-- 3. Detail & Statistik -->
        <div class="info-section">
            <div class="meta-stats" style="margin: 15px 0; color: #ccc;">
                <!-- Menggunakan pengaman (ternary) agar tidak error jika data kosong -->
                <span><strong>Views:</strong> <%= video.views ? video.views.toLocaleString() : '0' %></span> | 
                <span><strong>Likes:</strong> <%= (video.vote && video.vote.up) ? video.vote.up.toLocaleString() : '0' %></span> | 
                <span><strong>Duration:</strong> <%= video.durationFormatted || 'N/A' %></span>
            </div>

            <!-- 4. Tags (Clickable) -->
            <div class="tags-container" style="margin-top: 15px;">
                <strong>Tags:</strong> 
                <% if(video.tags && video.tags.length > 0) { %>
                    <% video.tags.forEach(tag => { %>
                        <a href="/?q=<%= encodeURIComponent(tag) %>" class="tag"><%= tag %></a>
                    <% }) %>
                <% } else { %>
                    <span>Tidak ada tag</span>
                <% } %>
            </div>

            <!-- 5. Deskripsi -->
            <div class="desc-content" style="margin-top: 15px; color: #ccc;">
                <strong>Description:</strong>
                <p><%= video.description || 'No description available.' %></p>
            </div>
        </div>

    <% } catch (error) { %>
        <!-- JIKA GAGAL, TAMPILKAN INI AGAR TIDAK CRASH -->
        <div class="error-msg" style="color: red; padding: 20px;">
            <p>Data video tidak dapat dimuat saat ini.</p>
            <p>Error Details: <%= error.message %></p>
        </div>
    <% } %>
